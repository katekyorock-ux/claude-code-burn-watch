# Copy this file to .env (next to burn-watch.js) and put your webhook URL in it.
# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
BURN_WATCH_DISCORD_WEBHOOK=

# Optional. These are the defaults.
# BURN_WATCH_RATIO=3
# BURN_WATCH_SESSION_FLOOR=30000000
# BURN_WATCH_TOTAL_FLOOR=150000000
# BURN_WATCH_COOLDOWN_HOURS=3
# BURN_WATCH_FORK_ALERT=1
# BURN_WATCH_LABELS=0
